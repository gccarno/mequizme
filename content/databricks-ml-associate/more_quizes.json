      "type": "mcq_single",
      "prompt": "A data scientist wants to compare hyperparameters and validation metrics across 20 runs in the MLflow UI. What is the best approach?",
      "choices": [
        {
          "id": "A",
          "text": "Open each run and copy the values into a spreadsheet"
        },
        {
          "id": "B",
          "text": "Export the data through the REST API only"
        },
        {
          "id": "C",
          "text": "Compare is not possible, because the UI shows one run at a time"
        },
        {
          "id": "D",
          "text": "Select the runs in the experiment’s runs table and open the comparison view"
        }
      ],
      "answer": {
        "choiceIds": [
          "D"
        ]
