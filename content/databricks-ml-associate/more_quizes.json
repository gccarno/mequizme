      "id": "b0980093-cad6-5f2e-9384-1f2ed6d995ec",
      "type": "mcq_single",
      "prompt": "Which is an advantage of random search over grid search for tuning many hyperparameters under a fixed budget?",
      "choices": [
        {
          "id": "A",
          "text": "It often finds comparably good settings in fewer trials, since grid cost multiplies with each added hyperparameter"
        },
        {
          "id": "B",
          "text": "It guarantees the global optimum"
        },
        {
          "id": "C",
          "text": "It needs no hyperparameter ranges"
        },
        {
          "id": "D",
          "text": "It is deterministic and never repeats a setting"
        }
      ],
      "answer": {
        "choiceIds": [
          "A"
        ]
      },
