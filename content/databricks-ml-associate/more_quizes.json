    {
      "id": "c35b135e-e964-54ac-8e17-713fb22bcb78",
      "type": "mcq_single",
      "prompt": "Why does Databricks recommend, in most situations, promoting code rather than models between environments?",
      "choices": [
        {
          "id": "A",
          "text": "Model artifacts cannot be copied between catalogs"
        },
        {
          "id": "B",
          "text": "Code promotion removes the need for a model registry"
        },
        {
          "id": "C",
          "text": "All code goes through the same review and integration testing, and the production model is trained on production code"
        },
        {
          "id": "D",
          "text": "Retraining in production is always cheaper than copying a model"
        }
      ],
      "answer": {
        "choiceIds": [
          "C"
        ]
      },
      "topics": [],
      "tags": [],
      "resources": [],
      "media": [],
      "status": "reviewed",
      "createdAt": "2026-11-22T01:59:26Z",
