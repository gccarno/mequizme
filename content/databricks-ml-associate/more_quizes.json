      "type": "mcq_single",
      "prompt": "What is a benefit of k-fold cross-validation over a single train-validation split?",
      "choices": [
        {
          "id": "A",
          "text": "Every row is used for validation exactly once, giving a more reliable estimate"
        },
        {
          "id": "B",
          "text": "It lowers training cost"
        },
        {
          "id": "C",
          "text": "It removes the need for a test set"
        },
        {
          "id": "D",
          "text": "It guarantees no overfitting"
        }
      ],
      "answer": {
        "choiceIds": [
          "A"
        ]
