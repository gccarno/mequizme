    {
      "id": "7306f379-29cc-52ae-be6d-c52593efcd9e",
      "type": "mcq_single",
      "prompt": "Why is one-hot encoding preferred over integer category indices for a nominal feature in a linear regression?",
      "choices": [
        {
          "id": "A",
          "text": "Integer indices use more memory"
        },
        {
          "id": "B",
          "text": "Linear models cannot accept numeric inputs"
        },
        {
          "id": "C",
          "text": "Integer indices imply an order and magnitude between categories that does not exist"
        },
        {
          "id": "D",
          "text": "One-hot encoding reduces the number of features"
        }
      ],
      "answer": {
        "choiceIds": [
          "C"
        ]
      },
