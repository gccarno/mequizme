    {
      "id": "5e56ca99-8a8f-5ef6-85ba-83d8d326b5a9",
      "type": "mcq_single",
      "prompt": "Training a large deep neural network is very expensive and hard to reproduce. All work happens in a single workspace, with no external repos or CI/CD. Which promotion approach fits best?",
      "choices": [
        {
          "id": "A",
          "text": "Promote the code and retrain in every environment"
        },
        {
          "id": "B",
          "text": "Promote the trained model artifact through the environments"
        },
        {
          "id": "C",
          "text": "Retrain weekly in each environment"
        },
        {
          "id": "D",
          "text": "Neither approach works without CI/CD"
        }
      ],
      "answer": {
        "choiceIds": [
          "B"
        ]
      },
