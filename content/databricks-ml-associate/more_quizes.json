    },
    {
      "id": "eb520d74-493e-5fe1-92e1-ebf3ef46fff8",
      "type": "mcq_single",
      "prompt": "A Spark ML pipeline has the stages StringIndexer, OneHotEncoder, VectorAssembler, and LogisticRegression. What does pipeline.fit(train_df) return?",
      "choices": [
        {
          "id": "A",
          "text": "A PipelineModel whose stages are fitted transformers"
        },
        {
          "id": "B",
          "text": "The same Pipeline object, unchanged"
        },
        {
          "id": "C",
          "text": "Only a LogisticRegressionModel"
        },
        {
          "id": "D",
          "text": "A DataFrame of predictions"
        }
      ],
      "answer": {
        "choiceIds": [
          "A"
        ]
      },
      "topics": [],
      "tags": [],
