    {
      "id": "e8f5d807-2d8b-5dd8-a941-ca32ea259c22",
      "type": "mcq_single",
      "prompt": "A column has a mean of 50 and a standard deviation of 10. Which range keeps the rows left after removing values more than 3 standard deviations from the mean?",
      "choices": [
        {
          "id": "A",
          "text": "40 to 60"
        },
        {
          "id": "B",
          "text": "20 to 80"
        },
        {
          "id": "C",
          "text": "30 to 70"
        },
        {
          "id": "D",
          "text": "0 to 100"
        }
      ],
      "answer": {
        "choiceIds": [
          "B"
        ]
      },
      "topics": [],
      "tags": [],
      "resources": [],
      "media": [],
