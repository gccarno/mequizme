      "type": "mcq_single",
      "prompt": "A data scientist must predict next month’s dollar spend per customer from labeled history. Which approach fits?",
      "choices": [
        {
          "id": "A",
          "text": "k-means clustering"
        },
        {
          "id": "B",
          "text": "A logistic regression classifier"
        },
        {
          "id": "C",
          "text": "A regression model, such as linear regression or a gradient-boosted trees regressor"
        },
        {
          "id": "D",
          "text": "PCA"
        }
      ],
      "answer": {
        "choiceIds": [
          "C"
        ]
      },
