    {
      "id": "749ec5ae-eb19-59d8-8927-564d37971c45",
      "type": "mcq_single",
      "prompt": "Which is a benefit of registering a model in the Unity Catalog registry rather than the workspace registry?",
      "choices": [
        {
          "id": "A",
          "text": "Models are governed securables with Unity Catalog access control, usable from any workspace attached to the same metastore"
        },
        {
          "id": "B",
          "text": "Models support fixed Staging and Production stages natively"
        },
        {
          "id": "C",
          "text": "Registered models are deployed to a serving endpoint automatically"
        },
        {
          "id": "D",
          "text": "Models can be registered without a three-level name"
        }
      ],
      "answer": {
        "choiceIds": [
          "A"
        ]
      },
