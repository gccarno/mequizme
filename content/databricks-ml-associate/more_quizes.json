    {
      "id": "076c72f8-db3b-5c62-b0d8-0d31dcb66aac",
      "type": "mcq_single",
      "prompt": "A Unity Catalog feature table holds features for 1 million customers. A job has fresh values for only 10,000 of them. How should the table be updated?",
      "choices": [
        {
          "id": "A",
          "text": "Call fe.create_table(...) again"
        },
        {
          "id": "B",
          "text": "Call fe.write_table(..., mode=\"overwrite\")"
        },
        {
          "id": "C",
          "text": "Drop the table and recreate it with SQL"
        },
        {
          "id": "D",
          "text": "Call fe.write_table(name=..., df=updates_df, mode=\"merge\")"
        }
      ],
      "answer": {
        "choiceIds": [
          "D"
        ]
      },
