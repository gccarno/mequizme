      "id": "275131e3-dfeb-5230-8db8-8ac3f7efe0a3",
      "type": "mcq_single",
      "prompt": "Which pairing of feature type and visualization is the most appropriate for exploring a dataset?",
      "choices": [
        {
          "id": "A",
          "text": "Continuous: pie chart. Categorical: histogram"
        },
        {
          "id": "B",
          "text": "Continuous: line chart of row counts. Categorical: scatter plot"
        },
        {
          "id": "C",
          "text": "Continuous: histogram or box plot. Categorical: bar chart of category counts"
        },
        {
          "id": "D",
          "text": "Continuous: pie chart. Categorical: line chart"
        }
      ],
      "answer": {
        "choiceIds": [
          "C"
