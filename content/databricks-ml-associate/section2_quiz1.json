      "id": "38dbbe87-d0bd-5446-bd2a-6bef3a79241b",
      "type": "mcq_single",
      "prompt": "The annual_income column is heavily right-skewed. A few very large values pull the average far above a typical value, and some entries are missing. Which imputation value is most appropriate?",
      "choices": [
        {
          "id": "A",
          "text": "The mean"
        },
        {
          "id": "B",
          "text": "The mode"
        },
        {
          "id": "C",
          "text": "Zero"
        },
        {
          "id": "D",
          "text": "The median"
        }
      ],
      "answer": {
        "choiceIds": [
          "D"
        ]
      },
