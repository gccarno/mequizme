      "id": "c74767d9-6490-5533-82e0-05884ea6545a",
      "type": "mcq_single",
      "prompt": "A data scientist wants to examine the relationship between two categorical features, region and plan_type. Which approach is most appropriate?",
      "choices": [
        {
          "id": "A",
          "text": "A cross-tabulation (contingency table), shown as stacked or grouped bars, or tested with chi-square"
        },
        {
          "id": "B",
          "text": "The Pearson correlation coefficient"
        },
        {
          "id": "C",
          "text": "A scatter plot of the two columns"
        },
        {
          "id": "D",
          "text": "A separate histogram of each column"
        }
      ],
      "answer": {
        "choiceIds": [
          "A"
        ]
