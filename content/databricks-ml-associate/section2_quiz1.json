    {
      "id": "9ea34755-30a8-5293-b38a-2da93465f6f6",
      "type": "mcq_single",
      "prompt": "The payment_method column is nominal (card, cash, transfer) and has missing values. Which imputation approach is most appropriate?",
      "choices": [
        {
          "id": "A",
          "text": "The most frequent category (the mode)"
        },
        {
          "id": "B",
          "text": "The mean of the category codes"
        },
        {
          "id": "C",
          "text": "The median of the category codes"
        },
        {
          "id": "D",
          "text": "The average of the two most frequent categories"
        }
      ],
      "answer": {
        "choiceIds": [
          "B"
        ]
      },
