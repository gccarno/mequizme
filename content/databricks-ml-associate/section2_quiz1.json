      "id": "82756583-e310-598b-aa79-8cd368734bf5",
      "type": "mcq_single",
      "prompt": "Which feature is the best candidate for a log transformation before training a linear regression?",
      "choices": [
        {
          "id": "A",
          "text": "A feature uniformly distributed between 0 and 1"
        },
        {
          "id": "B",
          "text": "A binary flag (0 or 1)"
        },
        {
          "id": "C",
          "text": "A feature symmetric around zero, with both negative and positive values"
        },
        {
          "id": "D",
          "text": "A strictly positive, right-skewed transaction amount spanning several orders of magnitude"
        }
      ],
      "answer": {
        "choiceIds": [
          "D"
        ]
