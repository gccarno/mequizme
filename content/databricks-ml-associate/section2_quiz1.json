      "id": "7efe6406-a57e-5cc8-a87c-7746be54ec2d",
      "type": "mcq_single",
      "prompt": "A string column city must be one-hot encoded for a Spark ML model. Which stage order is correct?",
      "choices": [
        {
          "id": "A",
          "text": "Apply OneHotEncoder directly to the string column"
        },
        {
          "id": "B",
          "text": "VectorAssembler, then OneHotEncoder"
        },
        {
          "id": "C",
          "text": "StringIndexer, then OneHotEncoder"
        },
        {
          "id": "D",
          "text": "StandardScaler, then OneHotEncoder"
        }
      ],
      "answer": {
        "choiceIds": [
          "C"
        ]
      },
