    {
      "id": "3c3b2cde-aea6-5583-8d75-afe286a87418",
      "type": "mcq_single",
      "prompt": "For which feature is one-hot encoding the least appropriate?",
      "choices": [
        {
          "id": "A",
          "text": "color, a nominal feature with 4 values, used in a linear regression"
        },
        {
          "id": "B",
          "text": "zip_code, a nominal feature with about 40,000 distinct values, used in a linear model"
        },
        {
          "id": "C",
          "text": "region, a nominal feature with 6 values, used in a logistic regression"
        },
        {
          "id": "D",
          "text": "day_of_week, a nominal feature with 7 values, used in a neural network"
        }
      ],
      "answer": {
        "choiceIds": [
          "B"
        ]
