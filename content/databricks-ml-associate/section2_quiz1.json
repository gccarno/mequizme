    {
      "id": "3fed20a4-88dd-5898-89ec-e45d45d47f78",
      "type": "mcq_single",
      "prompt": "A data scientist has a Spark DataFrame df with numeric columns. They need the count, mean, standard deviation, min, 25th/50th/75th percentiles, and max for each column. Which call returns all of these by default?",
      "choices": [
        {
          "id": "A",
          "text": "df.describe()"
        },
        {
          "id": "B",
          "text": "df.printSchema()"
        },
        {
          "id": "C",
          "text": "df.summary()"
        },
        {
          "id": "D",
          "text": "df.explain()"
        }
      ],
      "answer": {
        "choiceIds": [
          "C"
        ]
      },
      "topics": [
        "data-processing"
      ],
