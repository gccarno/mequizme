    {
      "id": "30e9507f-49e5-5850-9360-88924ae0fc9d",
      "type": "mcq_single",
      "prompt": "In a Databricks notebook, a data scientist wants a quick interactive profile of a DataFrame, with per-column statistics and distribution charts. Which call does this?",
      "choices": [
        {
          "id": "A",
          "text": "display(df.limit(10))"
        },
        {
          "id": "B",
          "text": "df.describe().show()"
        },
        {
          "id": "C",
          "text": "dbutils.fs.ls(\"/\")"
        },
        {
          "id": "D",
          "text": "dbutils.data.summarize(df)"
        }
      ],
      "answer": {
        "choiceIds": [
          "D"
        ]
      },
      "topics": [
        "data-processing"
