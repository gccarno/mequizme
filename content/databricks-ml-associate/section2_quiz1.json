    {
      "id": "ed837747-0eb9-5bc6-bc9f-0c00beb5ce2a",
      "type": "mcq_single",
      "prompt": "For the column amount, approxQuantile gives Q1 = 10 and Q3 = 30. Using the standard 1.5 × IQR rule, which filter removes the outliers?",
      "choices": [
        {
          "id": "A",
          "text": "Keep rows where amount is between 10 and 30"
        },
        {
          "id": "B",
          "text": "Keep rows where amount is between −20 and 60"
        },
        {
          "id": "C",
          "text": "Keep rows where amount is greater than 60"
        },
        {
          "id": "D",
          "text": "Keep rows where amount is between −50 and 90"
        }
      ],
      "answer": {
        "choiceIds": [
          "B"
        ]
      },
      "topics": [
        "data-processing"
